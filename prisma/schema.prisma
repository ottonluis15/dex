generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  LAWYER
  ASSISTANT
  INTERN
}

enum ClientType {
  PF
  PJ
}

enum CaseArea {
  CIVIL
  CRIMINAL
  TRABALHISTA
  TRIBUTARIO
  FAMILIA
  EMPRESARIAL
  PREVIDENCIARIO
  AMBIENTAL
  CONSUMIDOR
  DIGITAL
}

enum CaseStatus {
  NOVO
  EM_ANDAMENTO
  AGUARDANDO
  CONCLUIDO
  ARQUIVADO
}

enum EventType {
  MOVIMENTACAO
  AUDIENCIA
  DESPACHO
  SENTENCA
  PETICAO
  NOTA
}

enum FinancialType {
  RECEITA
  DESPESA
}

enum FinancialStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum NotificationType {
  PRAZO
  PROCESSO
  FINANCEIRO
  SISTEMA
}

enum EmailType {
  PASSWORD_RESET
  WELCOME
  CASE_UPDATE
  DEADLINE
  NEWSLETTER
  INVITE
}

enum EmailStatus {
  SENT
  FAILED
  PENDING
}

model Office {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  email     String   @unique
  phone     String?
  address   String?
  logo      String?
  area      CaseArea @default(CIVIL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  clients         Client[]
  cases           Case[]
  financialEntries FinancialEntry[]
  emailLogs       EmailLog[]

  @@map("offices")
}

model User {
  id               String    @id @default(cuid())
  officeId         String
  name             String
  email            String    @unique
  password         String
  role             UserRole  @default(LAWYER)
  oab              String?
  phone            String?
  avatar           String?
  isActive         Boolean   @default(true)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  office        Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  cases         Case[]         @relation("ResponsibleLawyer")
  events        CaseEvent[]
  documents     Document[]
  notifications Notification[]

  @@map("users")
}

model Client {
  id        String     @id @default(cuid())
  officeId  String
  name      String
  cpfCnpj   String?
  email     String?
  phone     String?
  address   String?
  type      ClientType @default(PF)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  cases  Case[]

  @@map("clients")
}

model Case {
  id             String     @id @default(cuid())
  officeId       String
  clientId       String
  responsibleId  String
  number         String?
  title          String
  description    String?
  area           CaseArea   @default(CIVIL)
  status         CaseStatus @default(NOVO)
  court          String?
  judge          String?
  estimatedValue Float?
  deadline       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  office      Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsible User             @relation("ResponsibleLawyer", fields: [responsibleId], references: [id])
  events      CaseEvent[]
  documents   Document[]
  financial   FinancialEntry[]

  @@map("cases")
}

model CaseEvent {
  id          String    @id @default(cuid())
  caseId      String
  userId      String
  type        EventType @default(NOTA)
  title       String
  description String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("case_events")
}

model FinancialEntry {
  id          String          @id @default(cuid())
  caseId      String?
  officeId    String
  type        FinancialType
  description String
  amount      Float
  status      FinancialStatus @default(PENDENTE)
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  case   Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@map("financial_entries")
}

model Document {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  name      String
  type      String
  path      String
  size      Int
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("documents")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SISTEMA)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model EmailLog {
  id        String      @id @default(cuid())
  officeId  String?
  to        String
  subject   String
  type      EmailType
  status    EmailStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  office Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  @@map("email_logs")
}
